{
  "expo": {
    "name": "meo.md",
    "slug": "meo-md",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "meomd",
    "newArchEnabled": false,
    "ios": { "supportsTablet": true, "bundleIdentifier": "md.meo.mobile" },
    "android": { "package": "md.meo.mobile" },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "./llama-rn-plugin.js",
      "onnxruntime-react-native"
    ],
    "extra": {
      "dataBackend": "supabase",
      "apiUrl": "http://localhost:8787",
      "supabaseUrl": "http://127.0.0.1:54321",
      "supabaseAnonKey": ""
    }
  }
}
