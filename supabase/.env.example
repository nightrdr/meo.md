# Env vars consumed by `supabase start` via the `env(...)` syntax in
# config.toml. Copy this file to `supabase/.env` (gitignored) and fill
# in the real values.
#
# Resend SMTP API key — used by [auth.email.smtp] when uncommented.
# Get yours at https://resend.com/api-keys
RESEND_API_KEY=re_replace_me_with_your_key
